# Copy to .env for local testing:  set -a; . ./.env; set +a; python monitor.py --show
# On GitHub, put the first block in Actions *Secrets* and the rest in Actions *Variables*.

# ---- secrets ----
LUX_USERNAME=you@example.com
LUX_PASSWORD=your-portal-password
LUX_SERIAL=                      # optional, auto-detected
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_IDS=-1001234567890 # group id, or comma-separated personal ids
NTFY_TOPIC=                      # optional second channel, e.g. maverick-solar-x7k29q
ANTHROPIC_API_KEY=               # optional: plain-English fault explanations

# ---- settings (defaults shown) ----
LUX_BASE_URL=https://af.luxpowertek.com   # use the address YOU log in at
TIMEZONE=Africa/Lagos
SYSTEM_NAME=Solar
DAY_START=08:00
DAY_END=17:00
PEAK_START=10:00
PEAK_END=15:00
DAY_DISCHARGE_W=300
PV_LOW_W=150
LOW_SOC=30
CRITICAL_SOC=20
RAPID_DRAIN_PCT_PER_HR=15
STALE_MIN=30
CONSECUTIVE_CHECKS=2
COOLDOWN_MIN=120
DAILY_SUMMARY_HOUR=19            # -1 disables the daily "I'm alive" message
CLAUDE_MODEL=claude-haiku-5-5
